<view class="card">
  <view class="title">Vivian 的工作台</view>
  <view class="muted">登录后数据云端同步，网页 / 手机 / 小程序通用</view>

  <input class="input" placeholder="用户名" value="{{username}}" bindinput="onUser" />
  <input class="input" placeholder="密码（至少4位）" password value="{{password}}" bindinput="onPwd" />

  <button class="btn" bindtap="onLogin" loading="{{loading}}">登录</button>
  <button class="btn ghost" style="margin-top:16rpx" bindtap="onRegister" loading="{{loading}}">注册新账号</button>

  <view style="color:#c91a4e;margin-top:16rpx;font-size:24rpx" wx:if="{{error}}">{{error}}</view>
</view>
